  { t:'pg_kompleks', soal:'Pilih semua ciri informasi yang diwaspadai hoaks.', opsi:['Judul provokatif','Ada tanggal dan penulis jelas','Mendesak untuk disebar','Situs tak terdaftar'], j:[0,2,3], msg:'Judul provokatif & ajakan menyebar cepat adalah indikasi hoaks.' }
];

function imgErr(el){ el.onerror=null; el.src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><rect width='100%' height='100%' fill='%23ECEFF1'/><text x='50%' y='55%' font-size='28' text-anchor='middle'>🖼️</text></svg>"; }
function setTxt(id,v){ const e=document.getElementById(id); if(e) e.textContent=v; }
function setSrc(id,v){ const e=document.getElementById(id); if(e) e.setAttribute('src',v); }

function applyConfig(){
  const C=CONFIG;
  setTxt('cfg-fase',C.fase); setTxt('cfg-judul',C.judul); setTxt('cfg-subjudul',C.subJudul);
  setSrc('cfg-bgjudul',C.bgJudul); setTxt('cfg-judul-menu',C.judul);
  setTxt('cfg-mapel',C.mapel); setTxt('cfg-unit',C.unit); setTxt('cfg-subunit',C.subUnit); setTxt('cfg-tp',C.tp);
  setTxt('cfg-nama',C.profil.nama); setTxt('cfg-nama2',C.profil.nama);
  setTxt('cfg-instansi',C.profil.instansi); setTxt('cfg-jenis',C.profil.jenis); setSrc('cfg-foto',C.profil.foto);
  document.title=C.judul+' — MPI';
}

let soundOn = true, globalVolume = 1, AUDIO = {};
function loadAudio(k,s){ try{ const a=new Audio(s); a.preload='auto'; AUDIO[k]=a; }catch(e){} }
loadAudio('bgm','./asset/audio/bgm.mp3'); if(AUDIO['bgm']) AUDIO['bgm'].loop = true;
loadAudio('klik','./asset/audio/sfx_klik.mp3'); loadAudio('benar','./asset/audio/sfx_benar.mp3');
loadAudio('salah','./asset/audio/sfx_salah.mp3'); loadAudio('transisi','./asset/audio/sfx_transisi.mp3');

function play(k){ if(!soundOn || !AUDIO[k]) return; try{ AUDIO[k].volume=globalVolume; if(k!=='bgm') AUDIO[k].currentTime=0; AUDIO[k].play().catch(()=>{}); }catch(e){} }
function changeVolume(v){ globalVolume=parseFloat(v); for(let k in AUDIO) if(AUDIO[k]) AUDIO[k].volume=globalVolume; }
function toggleSound(){ soundOn=!soundOn; document.getElementById('sound-toggle').textContent=soundOn?'🔊':'🔇'; if(!soundOn&&AUDIO['bgm']) AUDIO['bgm'].pause(); }

document.addEventListener('click', e => { if(e.target.closest('[data-sfx]')) play('klik'); });

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const aw=document.getElementById('audio-widget'); if(aw) aw.style.display=(id==='scr-judul')?'none':'flex';
  if(id!=='scr-judul') play('transisi');
}
function goJudul(){ showScreen('scr-judul'); }
function goMenu(){ showScreen('scr-menu'); }

let infoMurid = { nama:"Murid", sekolah:"-" };
function simpanIdentitas(){
  const nm=document.getElementById('in-nama').value.trim();
  if(!nm){ document.getElementById('login-pesan').style.display='block'; return; }
  infoMurid.nama=nm; infoMurid.sekolah=document.getElementById('in-sekolah').value.trim()||"-";
  closeModal('modal-login'); play('bgm'); goMenu();
}

const belajar = { step:0 };
function startBelajar(){ belajar.step=0; showScreen('scr-belajar'); renderBelajar(); }
function renderBelajar(){
  const total=MATERI.length; const m=MATERI[belajar.step];
  document.getElementById('belajar-pfill').style.width=((belajar.step+1)/total*100)+'%';
  document.getElementById('belajar-plabel').textContent=(belajar.step+1)+'/'+total;
  document.getElementById('belajar-sub').textContent=m.judul;
  
  document.getElementById('belajar-content').innerHTML = `
    <div class="belajar-frame">
      <div class="belajar-img-sisi"><img src="${m.img}" alt="${m.judul}" onerror="imgErr(this)"></div>
      <div class="belajar-teks-sisi">
        <h2>${m.judul}</h2>
        <div class="belajar-intro">${m.intro}</div>
        <div class="belajar-isi">${m.isi}</div>
      </div>
    </div>`;
}
function belajarNext(){ if(belajar.step < MATERI.length-1){ belajar.step++; renderBelajar(); } else goMenu(); }
function belajarPrev(){ if(belajar.step > 0){ belajar.step--; renderBelajar(); } else goMenu(); }

let skorBermain=0, main={step:0};
function startBermain(){ main.step=0; skorBermain=0; showScreen('scr-bermain'); renderBermain(); }
function renderBermain(){
  const game=dataBermain[main.step];
  document.getElementById('bermain-pfill').style.width=((main.step+1)/dataBermain.length*100)+'%';
  document.getElementById('bermain-plabel').textContent=(main.step+1)+'/'+dataBermain.length;
  document.getElementById('bermain-sub').textContent=game.sub;
  document.getElementById('bermain-next').disabled=false;
  
  document.getElementById('bermain-content').innerHTML=`<div class="center-col"><p class="akt-instruksi">${game.ins}</p><div class="feedback show ok">Mode Interaktif Siap untuk Layar Sentuh!</div></div>`;
}
function bermainNext(){ if(main.step<dataBermain.length-1){ main.step++; renderBermain(); } else goMenu(); }
function bermainPrev(){ if(main.step>0){ main.step--; renderBermain(); } else goMenu(); }

let latih={ step:0, skor:0 };
function startBerlatih(){ latih={step:0,skor:0}; showScreen('scr-berlatih'); renderBerlatih(); }
function renderBerlatih(){
  if(latih.step>=dtLatih.length){ goMenu(); return; }
  const q=dtLatih[latih.step];
  document.getElementById('berlatih-pfill').style.width=((latih.step+1)/dtLatih.length*100)+'%';
  document.getElementById('berlatih-plabel').textContent=(latih.step+1)+'/'+dtLatih.length;
  
  let opsiHTML='';
  if(q.opsi) q.opsi.forEach((o,i)=> { opsiHTML+=`<div class="opsi" onclick="jawabLatih(${i===q.j})"><span class="bul">${String.fromCharCode(65+i)}</span>${o}</div>`; });
  else opsiHTML=`<button class="btn btn-kuning" style="height:44px;width:100%;" onclick="jawabLatih(true)">Lanjutkan</button>`;

  document.getElementById('berlatih-content').innerHTML=`
    <div class="soal-split">
      <div class="soal-kiri"><div class="soal-label">Soal</div><div class="soal-teks">${q.soal}</div></div>
      <div class="opsi-kanan"><div class="opsi-list">${opsiHTML}</div><div class="feedback" id="bl-fb"></div></div>
    </div>`;
}
function jawabLatih(isBenar){
  const fb=document.getElementById('bl-fb');
  if(isBenar){ play('benar'); latih.skor++; fb.className='feedback show ok'; fb.textContent='✅ Benar!'; }
  else { play('salah'); fb.className='feedback show no'; fb.textContent='❌ Kurang Tepat!'; }
  document.getElementById('berlatih-next').disabled=false;
}
function berlatihNext(){ if(latih.step<dtLatih.length-1){ latih.step++; renderBerlatih(); } else goMenu(); }
function berlatihPrev(){ if(latih.step>0){ latih.step--; renderBerlatih(); } else goMenu(); }

function openModal(id){ document.getElementById(id).classList.add('show'); }
function closeModal(id){ document.getElementById(id).classList.remove('show'); }

applyConfig();
</script>
</body>
</html>

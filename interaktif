<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Template MPI</title>
<style>
  /* ====== KONFIGURASI WARNA ====== */
  :root {
    --primary: #3AA8E8;
    --primary-tua: #0B5C94;
    --accent: #F5B82E;
    --accent-tua: #C78A00;
    --tinta: #12385C;
    --krem: #FFFFFF;
    --krem-2: #F0F8FF;
    --garis: #CFE6F7;
    --hijau: #2ECC71;
    --hijau-tua: #27AE60;
    --salah: #E74C3C;
    --biru-muda: #E3F3FD;
    --bayang: 0 16px 32px rgba(58, 168, 232, 0.2);
    --bayang-kecil: 0 8px 20px rgba(0, 0, 0, 0.08);
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0; height: 100%; width: 100%;
    background: #DFE6E9; overflow: hidden;
    font-family: 'Nunito', 'Segoe UI', Tahoma, system-ui, sans-serif;
    color: var(--tinta); touch-action: manipulation;
  }
  #viewport { position: fixed; inset: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  #stage {
    position: relative; width: 100vw; height: 100vh;
    max-width: 1280px; max-height: 720px;
    background: var(--krem-2); overflow: hidden; user-select: none;
    display: flex; flex-direction: column;
  }
  @media (min-width: 768px) {
    #stage { border-radius: 20px; height: 100vh; max-height: 720px; }
  }

  .screen { position: absolute; inset: 0; display: none; flex-direction: column; z-index: 1; }
  .screen.active { display: flex; animation: fade .4s cubic-bezier(0.4, 0, 0.2, 1); }
  @keyframes fade { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: none; } }
  
  .bg { position: absolute; inset: 0; background-size: cover; background-position: center; z-index: 0; }
  .bg:not(:has(img)) { background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); }
  .bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }

  /* ====== Topbar & Navbar ====== */
  .topbar {
    position: relative; z-index: 5; height: 65px; flex: 0 0 65px;
    display: flex; align-items: center; gap: 10px; padding: 0 16px;
    background: #FFFFFF; border-bottom: 2px solid var(--garis);
    border-radius: 0 0 20px 20px; box-shadow: var(--bayang-kecil);
  }
  .topbar .judul-bar { font-weight: 800; font-size: 16px; color: var(--primary-tua); line-height: 1.2; }
  .topbar .judul-bar small { display: block; font-weight: 600; font-size: 12px; opacity: 0.7; }
  .spacer { flex: 1; }
  .progress-wrap { display: flex; align-items: center; gap: 8px; color: var(--primary-tua); }
  .progress-track { width: 100px; height: 12px; border-radius: 99px; background: #E2E8F0; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; border-radius: 99px; background: linear-gradient(90deg, var(--accent), var(--accent-tua)); transition: width .5s ease; }
  .progress-label { font-size: 12px; font-weight: 800; }
  .skor-badge {
    background: #FFF9E6; border: 2px solid #F1C40F; padding: 4px 12px;
    border-radius: 99px; font-weight: 900; font-size: 14px; color: #856404;
    display: flex; align-items: center; gap: 6px; box-shadow: var(--bayang-kecil);
  }
  .icon-btn {
    width: 40px; height: 40px; border: none; border-radius: 50%; cursor: pointer;
    background: var(--krem-2); color: var(--primary); font-size: 18px; font-weight: 800;
    display: flex; align-items: center; justify-content: center; transition: all .2s; box-shadow: var(--bayang-kecil); flex-shrink: 0;
  }
  .icon-btn:active { transform: scale(.9); }

  .content { position: relative; z-index: 4; flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; }
  .center-col { display: flex; flex-direction: column; height: 100%; min-height: 0; justify-content: center; width: 100%; }

  .navbar {
    position: relative; z-index: 5; height: 65px; flex: 0 0 65px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px;
    background: #FFFFFF; border-top: 2px solid var(--garis); border-radius: 20px 20px 0 0; box-shadow: 0 -8px 20px rgba(0,0,0,0.03);
  }
  .nav-btn {
    min-width: 120px; height: 44px; padding: 0 16px; border: none; border-radius: 99px; cursor: pointer; font-size: 14px; font-weight: 800; color: #fff;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; box-shadow: var(--bayang-kecil); transition: all .2s;
  }
  .nav-btn:active { transform: translateY(2px) scale(.98); }
  .nav-btn[disabled] { opacity: .4; cursor: not-allowed; }
  .nav-back { background: #95A5A6; }
  .nav-next { background: linear-gradient(135deg, var(--accent), var(--accent-tua)); }
  .btn { border: none; border-radius: 99px; cursor: pointer; font-weight: 800; color: #fff; box-shadow: var(--bayang-kecil); transition: all .2s; }
  .btn:active { transform: translateY(2px) scale(.96); }
  .btn-merah { background: linear-gradient(135deg, var(--salah), #C0392B); }
  .btn-biru { background: linear-gradient(135deg, #1D3557, #457B9D); }
  .btn-kuning { background: linear-gradient(135deg, var(--accent), var(--accent-tua)); color: #fff; }

  /* ====== JUDUL & MENU ====== */
  #scr-judul .bg::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.22) 50%, rgba(0,0,0,0.55) 100%), linear-gradient(135deg, rgba(230,57,70,0.18) 0%, rgba(29,53,87,0.16) 100%); }
  #scr-judul .bg img { opacity: 1; z-index: 0; } 
  .judul-center { position: relative; z-index: 4; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 8px; padding: 16px; overflow-y: auto; }
  .pita { background: #FFFFFF; color: var(--primary-tua); font-weight: 800; padding: 6px 18px; border-radius: 99px; font-size: 13px; box-shadow: var(--bayang-kecil); }
  .judul-utama { color: #FFFFFF; font-size: 28px; font-weight: 900; line-height: 1.2; margin: 6px 0 0; text-shadow: 0 2px 6px rgba(0,0,0,0.65); }
  .judul-sub { color: #F1FAEE; font-size: 16px; font-weight: 700; margin: 0; text-shadow: 0 2px 6px rgba(0,0,0,0.7); }
  .mulai-btn { margin-top: 16px; height: 50px; padding: 0 32px; font-size: 18px; border-radius: 99px; }
  .judul-topright { position: absolute; top: 16px; right: 16px; z-index: 6; display: flex; gap: 10px; }
  
  #scr-menu .bg { background: linear-gradient(180deg, #FDF2E9, #F1FAEE); }
  .menu-head { position: relative; z-index: 4; text-align: center; padding: 16px 16px 0; }
  .menu-head h2 { font-size: 22px; margin: 0; color: var(--primary-tua); font-weight: 900; }
  .menu-head p { font-size: 13px; margin: 4px 0 0; }
  .menu-cards { position: relative; z-index: 4; flex: 1; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center; padding: 16px; overflow-y: auto; }
  .menu-card {
    width: 100%; max-width: 320px; height: 80px; border-radius: 20px; cursor: pointer; color: #fff;
    display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 14px;
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.15); transition: all .3s; padding: 12px 20px; text-align: left; border: 2px solid rgba(255,255,255,0.3);
  }
  .menu-card:active { transform: scale(.98); }
  .menu-card .img-ikon { width: 50px; height: 50px; object-fit: contain; flex-shrink: 0; }
  .menu-card .mc-judul { font-size: 20px; font-weight: 900; }
  .menu-card .mc-sub { font-size: 12px; font-weight: 600; background: rgba(0,0,0,0.15); padding: 4px 10px; border-radius: 99px; display: inline-block; margin-top: 2px; }
  .mc-belajar { background: linear-gradient(135deg, #1D3557, #457B9D); }
  .mc-bermain { background: linear-gradient(135deg, var(--primary), var(--primary-tua)); }
  .mc-berlatih { background: linear-gradient(135deg, var(--accent), var(--accent-tua)); }

  /* ====== BELAJAR ====== */
  .belajar-frame { flex:1; display:flex; flex-direction:column; min-height:0; background:#fff; border-radius:20px; box-shadow:var(--bayang); overflow:hidden; border:2px solid var(--garis); }
  .belajar-img-sisi { flex:0 0 160px; max-height:160px; background:linear-gradient(160deg,#FFF6ED,#FDF2E9); display:flex; align-items:center; justify-content:center; padding:10px; border-bottom:2px solid var(--garis); }
  .belajar-img-sisi img { width:100%; height:100%; object-fit:contain; border-radius:12px; }
  .belajar-teks-sisi { flex:1; padding:16px; overflow-y:auto; display:flex; flex-direction:column; gap:12px; }
  .belajar-teks-sisi h2 { margin:0; font-size:20px; color:var(--primary-tua); font-weight:900; line-height:1.2; }
  .belajar-intro { background:linear-gradient(135deg,var(--primary),var(--primary-tua)); color:#fff; padding:10px 14px; border-radius:14px; font-size:14px; font-weight:800; line-height:1.3; }
  .belajar-isi { font-size:14px; line-height:1.5; color:var(--tinta); }
  .belajar-isi ul { margin:6px 0 0; padding-left:18px; }
  .belajar-isi li { margin-bottom:4px; }
  .belajar-isi b { color: var(--primary-tua); }
  .belajar-kuis { margin-top:auto; padding:12px; background:var(--biru-muda); border:2px dashed var(--primary); border-radius:14px; }
  .belajar-kuis .bk-tanya { font-weight:800; color:var(--primary-tua); font-size:13px; margin:0 0 8px; }
  .belajar-kuis .bk-opsi { display:flex; gap:8px; flex-wrap:wrap; }

  /* ====== SOAL & INTERAKTIF ====== */
  .akt-instruksi { font-size: 14px; margin: 0 0 10px; background: #fff; padding: 8px 16px; border-radius: 12px; display: block; box-shadow: var(--bayang-kecil); text-align: center; border: 1.5px solid var(--garis); font-weight: 700; }
  .soal { background: #FFFFFF; border-radius: 18px; padding: 14px 18px; font-size: 15px; font-weight: 800; line-height: 1.4; margin-bottom: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.03); color: var(--primary-tua); border-left: 6px solid var(--primary); }
  
  .soal-split { display: flex; flex-direction: column; gap: 12px; flex: 1; min-height: 0; overflow-y: auto; }
  .soal-split .soal-kiri {
    flex: none; background: #FFFFFF; border-radius: 18px; padding: 14px 16px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.03); border-left: 6px solid var(--primary);
    display: flex; flex-direction: column; gap: 8px;
  }
  .soal-split .soal-kiri .soal-label { font-size: 11px; font-weight: 900; color: var(--primary); letter-spacing: 1px; text-transform: uppercase; }
  .soal-split .soal-kiri .soal-teks { font-size: 15px; font-weight: 800; line-height: 1.4; color: var(--primary-tua); }
  .soal-split .soal-kiri .soal-stimulus { font-size: 13px; font-weight: 600; line-height: 1.4; color: var(--tinta); background: var(--krem-2); border-radius: 10px; padding: 8px 12px; border: 1px solid var(--garis); }
  .soal-split .soal-kiri .soal-img { width: 100%; max-height: 140px; object-fit: contain; border-radius: 10px; background: var(--krem-2); padding: 4px; }
  .soal-split .opsi-kanan { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .soal-split .opsi-list { display: flex; flex-direction: column; gap: 8px; }
  
  .opsi { background: #FFFFFF; border: 2px solid var(--garis); border-radius: 16px; padding: 10px 14px; font-size: 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.02); transition: all .2s; color: var(--tinta); }
  .opsi:hover { border-color: var(--primary); background: var(--biru-muda); }
  .opsi .bul { width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%; background: var(--garis); display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 13px; color: var(--primary-tua); transition: all .2s; }
  .opsi.benar { border-color: var(--hijau-tua); background: #ECFDF5; color: var(--hijau-tua); }
  .opsi.benar .bul { background: var(--hijau-tua); color: #fff; }
  .opsi.salah { border-color: var(--salah); background: #FEF2F2; color: var(--salah); }
  .opsi.salah .bul { background: var(--salah); color: #fff; }
  .opsi-kompleks { cursor: pointer; border: 2px solid var(--garis); background: #fff; }
  .opsi-kompleks.terpilih { border-color: var(--primary); background: var(--biru-muda); }
  .opsi-kompleks.terpilih .bul { background: var(--primary); color: #fff; }

  .kalimat-drag { font-size: 15px; line-height: 1.8; font-weight: 700; background: #fff; padding: 16px; border-radius: 18px; box-shadow: var(--bayang-kecil); border: 2px solid var(--garis); }
  .blank-slot { display: inline-block; min-width: 80px; height: 32px; border-bottom: 3px dashed var(--primary); margin: 0 4px; vertical-align: middle; text-align: center; color: var(--primary-tua); font-weight: 900; cursor: pointer; background: var(--biru-muda); border-radius: 6px 6px 0 0; }
  .blank-slot.terisi { border-bottom-style: solid; background: #D0EEFF; border-bottom-color: var(--primary-tua); }
  .word-pool { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; justify-content: center; }
  .word-btn { background: linear-gradient(135deg, var(--accent), var(--accent-tua)); border: none; padding: 8px 14px; font-size: 14px; font-weight: 800; border-radius: 10px; cursor: pointer; box-shadow: var(--bayang-kecil); color: #fff; }
  .word-btn.dipakai { opacity: 0; pointer-events: none; }

  .jodoh-wrap { position: relative; display: flex; gap: 12px; flex: 1; min-height: 0; justify-content: center; z-index: 1; }
  .jodoh-kol { flex: 1; display: flex; flex-direction: column; gap: 8px; justify-content: center; z-index: 2; }
  .pair-item { 
    position: relative; z-index: 2; border: 2px solid var(--garis); background: #fff; border-radius: 14px; 
    padding: 8px 12px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: flex-start; gap: 10px; 
    box-shadow: 0 2px 6px rgba(0,0,0,0.02); min-height: 50px; text-align: left; color: var(--tinta); transition: all 0.2s;
  }
  .pair-item img.img-pair { width: 32px; height: 32px; object-fit: contain; flex-shrink: 0; }
  .pair-item.sel { border-color: var(--accent); background: #FFF9E6; color: var(--accent-tua); }
  .pair-item.locked { border-color: var(--hijau-tua); background: #ECFDF5; color: var(--hijau-tua); }
  .pair-item.salah { border-color: var(--salah); background: #FEF2F2; animation: shake 0.4s; color: var(--salah); }
  
  .scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; flex: 1; overflow-y: auto; }
  .obj-card { 
    background: #fff; border: 2px solid var(--garis); border-radius: 16px; 
    padding: 10px; font-size: 13px; font-weight: 700; cursor: pointer; 
    display: flex; flex-direction: column; align-items: center; justify-content: center; 
    gap: 8px; text-align: center; box-shadow: var(--bayang-kecil); transition: all 0.2s; color: var(--tinta);
  }
  .obj-card img.img-obj { width: auto; height: 60px; object-fit: contain; }
  .obj-card.benar { border-color: var(--hijau-tua); background: #ECFDF5; color: var(--hijau-tua); }
  .obj-card.salah { border-color: var(--salah); background: #FEF2F2; color: var(--salah); }

  .urut-item { 
    background: #fff; border: 2px solid var(--garis); border-radius: 14px; padding: 8px 12px; 
    font-size: 13px; font-weight: 700; display: flex; align-items: center; 
    gap: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.02); margin-bottom: 8px; min-height: 48px; color: var(--tinta);
  }
  .urut-item .num { background: var(--primary); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex-shrink: 0; }
  .urut-item > span:nth-child(2) { flex: 1; line-height: 1.2; } 
  .urut-item .btn-kuning { flex: 0 0 auto; width: 32px; height: 32px; padding: 0; display:flex; align-items:center; justify-content:center; font-size: 14px; } 

  .bs-grid { display: flex; gap: 12px; margin-top: 10px; }
  .bs-btn { flex: 1; height: 70px; border-radius: 20px; border: none; font-size: 20px; font-weight: 900; color: #fff; cursor: pointer; box-shadow: var(--bayang-kecil); }
  .bs-benar { background: linear-gradient(135deg, var(--hijau), var(--hijau-tua)); }
  .bs-salah { background: linear-gradient(135deg, var(--salah), #C0392B); }

  .feedback { border-radius: 14px; padding: 10px 14px; font-size: 13px; font-weight: 700; line-height: 1.4; display: none; text-align: center; margin-top: 10px; }
  .feedback.show { display: block; }
  .feedback.ok { background: #D1FAE5; border: 2px solid var(--hijau-tua); color: var(--hijau-tua); }
  .feedback.no { background: #FEE2E2; border: 2px solid var(--salah); color: var(--salah); }

  /* ====== GAME ====== */
  .kumpul-hud { display: flex; justify-content: center; gap: 10px; align-items: center; margin-bottom: 8px; }
  .kumpul-hud .hud-box { background: #fff; padding: 4px 14px; border-radius: 99px; font-weight: 900; font-size: 14px; box-shadow: var(--bayang-kecil); border: 2px solid var(--garis); }
  .kumpul-hud .hud-time { color: var(--salah); border-color: var(--salah); }
  .kumpul-hud .hud-coll { color: var(--hijau-tua); border-color: var(--hijau-tua); }
  .kumpul-area { position: relative; width: 100%; flex: 1; min-height: 200px; background: radial-gradient(circle at 50% 40%, #FFFDF5, #FDF2E9); border: 2px dashed var(--accent); border-radius: 18px; overflow: hidden; }
  .kumpul-flag { position: absolute; width: 60px; cursor: pointer; }
  .kumpul-flag img { width: 100%; height: auto; pointer-events: none; }

  .sambung-lirik { background: linear-gradient(135deg, var(--primary), var(--primary-tua)); color:#fff; padding: 14px; border-radius: 16px; font-size: 16px; font-weight: 800; text-align:center; line-height:1.3; }
  .sambung-opsi { display:flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .sambung-btn { background:#fff; border: 2px solid var(--garis); border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 700; cursor:pointer; color: var(--tinta); text-align: left; }
  .sambung-btn.benar { border-color: var(--hijau-tua); background:#ECFDF5; color: var(--hijau-tua); }
  .sambung-btn.salah { border-color: var(--salah); background:#FEF2F2; color: var(--salah); }

  /* ====== MODAL & AKHIR ====== */
  #efek-salah { position: absolute; inset: 0; z-index: 45; pointer-events: none; background: rgba(231, 76, 60, 0); transition: background 0.6s ease-out; }
  #efek-salah.nyala { background: rgba(231, 76, 60, 0.4); transition: none; }
  .modal-bg { position: absolute; inset: 0; z-index: 50; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; padding: 16px; }
  .modal-bg.show { display: flex; }
  .modal { width: 100%; max-width: 500px; max-height: 85vh; overflow-y: auto; background: #FFFFFF; border-radius: 24px; padding: 20px; position: relative; border: 2px solid var(--primary); }
  .modal h3 { margin: 0 0 12px; font-size: 20px; color: var(--primary-tua); font-weight: 900; }
  .modal p, .modal li, .info-tabel td { font-size: 13px; line-height: 1.4; color: var(--tinta); }
  .modal .tutup { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; border-radius: 50%; font-weight: bold; background: var(--krem-2); color: var(--salah); display: flex; align-items: center; justify-content: center; cursor: pointer; border: 1.5px solid var(--garis); font-size: 16px; }
  .input-form { width: 100%; padding: 10px 14px; font-size: 15px; font-family: inherit; font-weight: 700; color: var(--tinta); border: 2px solid var(--garis); border-radius: 12px; margin-bottom: 12px; outline: none; background: #fff; }
  .info-tabel { width: 100%; border-collapse: collapse; margin-top: 8px; background: #fff; }
  .info-tabel td { border: 1.5px solid var(--garis); padding: 8px 10px; }
  .info-tabel td:first-child { font-weight: 800; background: var(--krem-2); width: 35%; color: var(--primary-tua); }
  
  .akhir { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 16px; }
  .akhir h2 { font-size: 26px; color: var(--primary-tua); margin: 0; font-weight: 900; }
  .akhir .skor-angka { font-size: 48px; font-weight: 900; color: var(--accent-tua); margin: 2px 0; }
  .akhir .identitas { font-size: 14px; font-weight: 700; background: #FFF9E6; padding: 6px 16px; border-radius: 99px; color: #856404; border: 1.5px solid #F1C40F; }

  #audio-widget {
    position: absolute; bottom: 75px; right: 16px; z-index: 60; background: #FFFFFF; padding: 4px 10px; border-radius: 99px;
    display: none; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.08); border: 1.5px solid var(--garis);
  }
  .icon-btn-small { width: 28px; height: 28px; border: none; border-radius: 50%; background: var(--krem-2); color: var(--primary); font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: justify; }
  #volume-slider { width: 60px; height: 4px; }

  /* ====== ADAPTASI MEDIA QUERIES UNTUK TABLET / DESKTOP (LANDSCAPE) ====== */
  @media (min-width: 600px) {
    .menu-cards { flex-direction: row; flex-wrap: wrap; }
